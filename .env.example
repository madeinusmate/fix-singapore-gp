# Browser-public config. Copy to .env and use your own Firebase project.
# Do not put a server or admin secret in a VITE_ variable.
VITE_RHEO_PUBLISHABLE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Default Firebase Storage bucket. A published layout uploads a public 3D picture here.
VITE_FIREBASE_STORAGE_BUCKET=
