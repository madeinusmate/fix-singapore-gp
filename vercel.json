{
  "rewrites": [
    {
      "source": "/l/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Slack-ImgProxy|WhatsApp|whatsapp|Discordbot|TelegramBot|Pinterest|redditbot|Embedly|Iframely|vkShare|SkypeUriPreview|MicrosoftPreview|Bluesky).*"
        }
      ],
      "destination": "/api/layout-card?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
