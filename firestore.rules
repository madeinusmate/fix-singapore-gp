rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function layoutPath(id) {
      return /databases/$(database)/documents/layouts/$(id);
    }
    function votePath(id) {
      return /databases/$(database)/documents/layouts/$(id)/votes/$(request.auth.uid);
    }
    function votesOf(d) {
      return d.get('votes', 0);
    }
    function imageOk(d, id) {
      return !d.keys().hasAny(['imageUrl'])
        || (d.imageUrl is string
          && d.imageUrl.size() <= 500
          && d.imageUrl.split('%2F').size() == 3
          && d.imageUrl.split('%2F')[0].matches('^https://firebasestorage\\.googleapis\\.com/v0/b/[A-Za-z0-9.\\-]+/o/layouts$')
          && d.imageUrl.split('%2F')[1] == d.creatorId
          && d.imageUrl.split('%2F')[2] == id + '.jpg?alt=media');
    }
    function valid(d, id) {
      return d.keys().hasOnly(['title', 'titleKey', 'racingSense', 'color', 'waypoints', 'path', 'thumb', 'summary', 'creatorId', 'creatorName', 'createdAt', 'updatedAt', 'simVersion', 'votes', 'imageUrl', 'revision'])
        && imageOk(d, id)
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 60
        && (!d.keys().hasAny(['titleKey']) || (d.titleKey is string && d.titleKey.size() > 0 && d.titleKey.size() <= 500))
        && d.racingSense in ['cw', 'ccw']
        && (!d.keys().hasAny(['revision']) || (d.revision is string && d.revision.size() > 0 && d.revision.size() <= 64))
        && d.color is string && d.color.size() > 0 && d.color.size() <= 20
        && d.waypoints is list && d.waypoints.size() <= 60
        && d.path is string && d.path.size() > 0 && d.path.size() <= 200000
        && d.thumb is string && d.thumb.size() > 0 && d.thumb.size() <= 20000
        && d.simVersion is int
        && d.creatorId is string
        && d.creatorName is string && d.creatorName.size() > 0 && d.creatorName.size() <= 80
        && votesOf(d) is int
        && d.summary.keys().hasOnly(['lengthKm', 'lapS', 'lapOvertakeS', 'overtakingIndex', 'heavyBraking', 'corners', 'topKmh'])
        && d.summary.lengthKm is number
        && d.summary.lapS is number
        && d.summary.lapOvertakeS is number
        && d.summary.overtakingIndex is number
        && d.summary.heavyBraking is number
        && d.summary.corners is number
        && d.summary.topKmh is number;
    }
    // A vote moves the counter by exactly one, in the same batch that creates
    // or deletes the voter's own votes/{uid} document.
    function voteChange(id) {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && (
          (votesOf(request.resource.data) == votesOf(resource.data) + 1
            && !exists(votePath(id)) && existsAfter(votePath(id)))
          || (votesOf(request.resource.data) == votesOf(resource.data) - 1
            && exists(votePath(id)) && !existsAfter(votePath(id)))
        );
    }
    function sameShape() {
      return request.resource.data.path == resource.data.path
        && request.resource.data.racingSense == resource.data.racingSense;
    }
    // A new path or a flipped racing sense must take a new revision. A rename,
    // recolor, or new photo keeps the revision, including on older layouts
    // that do not have one yet.
    function revisionOk() {
      return sameShape()
        ? (
          request.resource.data.get('revision', '') == resource.data.get('revision', '')
          || (
            !resource.data.keys().hasAny(['revision'])
            && request.resource.data.revision is string
            && request.resource.data.revision.size() > 0
            && request.resource.data.revision.size() <= 64
          )
        )
        : (
          request.resource.data.revision is string
          && request.resource.data.revision.size() > 0
          && request.resource.data.revision.size() <= 64
          && request.resource.data.revision != resource.data.get('revision', '')
        );
    }
    function namePath(key) {
      return /databases/$(database)/documents/layoutNames/$(key);
    }
    function nameHeld(id) {
      return request.resource.data.keys().hasAny(['titleKey'])
        && request.resource.data.titleKey is string
        && request.resource.data.titleKey.size() > 0
        && request.resource.data.titleKey.size() <= 500
        && existsAfter(namePath(request.resource.data.titleKey))
        && getAfter(namePath(request.resource.data.titleKey)).data.layoutId == id;
    }
    // A new layout must reserve its name. An older layout may keep publishing
    // until it is saved with a titleKey, and a rename must release the old one.
    function nameOk(id) {
      return resource == null
        ? nameHeld(id)
        : !resource.data.keys().hasAny(['titleKey'])
          ? (!request.resource.data.keys().hasAny(['titleKey']) || nameHeld(id))
          : nameHeld(id) && (
            request.resource.data.titleKey == resource.data.titleKey
            || !existsAfter(namePath(resource.data.titleKey))
          );
    }
    function creatorEdit(id) {
      return signedIn()
        && request.auth.uid == resource.data.creatorId
        && valid(request.resource.data, id)
        && revisionOk()
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.createdAt == resource.data.createdAt
        && votesOf(request.resource.data) == votesOf(resource.data)
        && request.resource.data.creatorName == request.auth.token.name
        && request.resource.data.updatedAt == request.time;
    }
    function boardPath(layoutId) {
      return /databases/$(database)/documents/lapBoards/$(layoutId);
    }
    function boardRow() {
      return request.resource.data.keys().hasOnly(['timeS', 'name', 'revision', 'setAt'])
        && request.resource.data.timeS is number
        && request.resource.data.timeS > 0
        && request.resource.data.timeS < 10000
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.name == request.auth.token.name
        && request.resource.data.revision is string
        && request.resource.data.revision.size() > 0
        && request.resource.data.revision.size() <= 64
        && request.resource.data.setAt == request.time;
    }
    function currentFloor() {
      return exists(boardPath('current'))
        && get(boardPath('current')).data.revision is string
        && get(boardPath('current')).data.simLapS is number
        && request.resource.data.revision == get(boardPath('current')).data.revision
        && request.resource.data.timeS >= get(boardPath('current')).data.simLapS / 2;
    }
    function publishedFloor(layoutId) {
      return exists(layoutPath(layoutId))
        && get(layoutPath(layoutId)).data.summary.lapS is number
        && request.resource.data.timeS >= get(layoutPath(layoutId)).data.summary.lapS / 2
        && (
          (
            get(layoutPath(layoutId)).data.keys().hasAny(['revision'])
            && get(layoutPath(layoutId)).data.revision == request.resource.data.revision
          )
          || !get(layoutPath(layoutId)).data.keys().hasAny(['revision'])
        );
    }
    function floorOk(layoutId) {
      return layoutId == 'current' ? currentFloor() : publishedFloor(layoutId);
    }
    function fasterOrNewRevision() {
      return resource.data.revision != request.resource.data.revision
        || request.resource.data.timeS < resource.data.timeS;
    }
    match /layouts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && valid(request.resource.data, id)
        && nameOk(id)
        && request.resource.data.revision is string
        && request.resource.data.revision.size() > 0
        && request.resource.data.revision.size() <= 64
        && votesOf(request.resource.data) == 0
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorName == request.auth.token.name
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (creatorEdit(id) && nameOk(id)) || voteChange(id);
      allow delete: if signedIn() && request.auth.uid == resource.data.creatorId;

      match /votes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && votesOf(getAfter(layoutPath(id)).data) == votesOf(get(layoutPath(id)).data) + 1;
        allow delete: if signedIn()
          && request.auth.uid == uid
          && votesOf(getAfter(layoutPath(id)).data) == votesOf(get(layoutPath(id)).data) - 1;
      }
    }

    match /layoutNames/{nameKey} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['layoutId'])
        && request.resource.data.layoutId is string
        && request.resource.data.layoutId.size() > 0
        && request.resource.data.layoutId.size() <= 200
        && existsAfter(layoutPath(request.resource.data.layoutId))
        && getAfter(layoutPath(request.resource.data.layoutId)).data.creatorId == request.auth.uid
        && getAfter(layoutPath(request.resource.data.layoutId)).data.titleKey == nameKey;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.layoutId is string
        && exists(layoutPath(resource.data.layoutId))
        && get(layoutPath(resource.data.layoutId)).data.creatorId == request.auth.uid
        && (
          !existsAfter(layoutPath(resource.data.layoutId))
          || getAfter(layoutPath(resource.data.layoutId)).data.get('titleKey', '') != nameKey
        );
    }

    match /lapBoards/{layoutId} {
      allow read: if true;
      allow write: if false;

      match /times/{uid} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == uid
          && boardRow()
          && floorOk(layoutId);
        allow update: if signedIn()
          && request.auth.uid == uid
          && boardRow()
          && floorOk(layoutId)
          && fasterOrNewRevision();
        allow delete: if signedIn()
          && layoutId != 'current'
          && exists(layoutPath(layoutId))
          && get(layoutPath(layoutId)).data.creatorId == request.auth.uid;
      }
    }
  }
}
