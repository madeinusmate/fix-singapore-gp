rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function layoutPath(id) {
      return /databases/$(database)/documents/layouts/$(id);
    }
    function votePath(id) {
      return /databases/$(database)/documents/layouts/$(id)/votes/$(request.auth.uid);
    }
    function votesOf(d) {
      return d.get('votes', 0);
    }
    function imageOk(d, id) {
      return !d.keys().hasAny(['imageUrl'])
        || (d.imageUrl is string
          && d.imageUrl.size() <= 500
          && d.imageUrl.split('%2F').size() == 3
          && d.imageUrl.split('%2F')[0].matches('^https://firebasestorage\\.googleapis\\.com/v0/b/[A-Za-z0-9.\\-]+/o/layouts$')
          && d.imageUrl.split('%2F')[1] == d.creatorId
          && d.imageUrl.split('%2F')[2] == id + '.jpg?alt=media');
    }
    function valid(d, id) {
      return d.keys().hasOnly(['title', 'racingSense', 'color', 'waypoints', 'path', 'thumb', 'summary', 'creatorId', 'creatorName', 'createdAt', 'updatedAt', 'simVersion', 'votes', 'imageUrl'])
        && imageOk(d, id)
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 60
        && d.racingSense in ['cw', 'ccw']
        && d.color is string && d.color.size() > 0 && d.color.size() <= 20
        && d.waypoints is list && d.waypoints.size() <= 60
        && d.path is string && d.path.size() > 0 && d.path.size() <= 200000
        && d.thumb is string && d.thumb.size() > 0 && d.thumb.size() <= 20000
        && d.simVersion is int
        && d.creatorId is string
        && d.creatorName is string && d.creatorName.size() > 0 && d.creatorName.size() <= 80
        && votesOf(d) is int
        && d.summary.keys().hasOnly(['lengthKm', 'lapS', 'lapOvertakeS', 'overtakingIndex', 'heavyBraking', 'corners', 'topKmh'])
        && d.summary.lengthKm is number
        && d.summary.lapS is number
        && d.summary.lapOvertakeS is number
        && d.summary.overtakingIndex is number
        && d.summary.heavyBraking is number
        && d.summary.corners is number
        && d.summary.topKmh is number;
    }
    // A vote moves the counter by exactly one, in the same batch that creates
    // or deletes the voter's own votes/{uid} document.
    function voteChange(id) {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && (
          (votesOf(request.resource.data) == votesOf(resource.data) + 1
            && !exists(votePath(id)) && existsAfter(votePath(id)))
          || (votesOf(request.resource.data) == votesOf(resource.data) - 1
            && exists(votePath(id)) && !existsAfter(votePath(id)))
        );
    }
    function creatorEdit(id) {
      return signedIn()
        && request.auth.uid == resource.data.creatorId
        && valid(request.resource.data, id)
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.createdAt == resource.data.createdAt
        && votesOf(request.resource.data) == votesOf(resource.data)
        && request.resource.data.creatorName == request.auth.token.name
        && request.resource.data.updatedAt == request.time;
    }
    match /layouts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && valid(request.resource.data, id)
        && votesOf(request.resource.data) == 0
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorName == request.auth.token.name
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if creatorEdit(id) || voteChange(id);
      allow delete: if signedIn() && request.auth.uid == resource.data.creatorId;

      match /votes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && votesOf(getAfter(layoutPath(id)).data) == votesOf(get(layoutPath(id)).data) + 1;
        allow delete: if signedIn()
          && request.auth.uid == uid
          && votesOf(getAfter(layoutPath(id)).data) == votesOf(get(layoutPath(id)).data) - 1;
      }
    }
  }
}
